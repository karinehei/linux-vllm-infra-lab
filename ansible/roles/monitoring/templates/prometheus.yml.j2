---
# Prometheus config generated from Ansible inventory (centralized scrape targets).
#
# Blackbox is a Compose service on the same network as Prometheus.
# Scrape it at {{ monitoring_blackbox_address }} — never 127.0.0.1:9115
# (that is Prometheus's own container loopback).
#
# vLLM /health and /metrics are included only when the API bind is reachable
# from this utility node (private NIC, not 127.0.0.1). Localhost-only binds
# stay private; see docs/monitoring.md.

global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_prometheus_port }}"]

{% if monitoring_scrape_node_exporter | bool %}
  - job_name: node
    static_configs:
{% for host in groups['ai_nodes'] | default([]) %}
      - targets: ["{{ hostvars[host].monitoring_scrape_ip | default(hostvars[host].ansible_host) }}:{{ monitoring_node_exporter_port }}"]
        labels:
          host: "{{ host }}"
          role: inference
{% endfor %}
{% for host in groups['monitoring_nodes'] | default([]) %}
      - targets: ["{{ hostvars[host].monitoring_scrape_ip | default(hostvars[host].ansible_host) }}:{{ monitoring_node_exporter_port }}"]
        labels:
          host: "{{ host }}"
          role: utility
{% endfor %}
{% endif %}

{% if monitoring_scrape_dcgm | bool %}
  - job_name: dcgm
    static_configs:
{% for host in groups['ai_nodes'] | default([]) %}
      - targets: ["{{ hostvars[host].monitoring_scrape_ip | default(hostvars[host].ansible_host) }}:{{ monitoring_dcgm_port }}"]
        labels:
          host: "{{ host }}"
          role: gpu
{% endfor %}
{% endif %}

{% if monitoring_scrape_vllm | bool %}
{% set ns = namespace(vllm_entries=[]) %}
{% for host in groups['ai_nodes'] | default([]) %}
{% set bind = hostvars[host].vllm_host | default('127.0.0.1') %}
{% set override = hostvars[host].monitoring_vllm_scrape_target | default('') %}
{% if override | length > 0 %}
{% set scrape_host = override %}
{% elif bind in ['0.0.0.0', '::', '*'] %}
{% set scrape_host = hostvars[host].monitoring_scrape_ip | default(hostvars[host].ansible_host) %}
{% elif bind not in ['127.0.0.1', 'localhost', '::1'] %}
{% set scrape_host = bind %}
{% else %}
{% set scrape_host = '' %}
{% endif %}
{% if scrape_host | length > 0 %}
{% set ns.vllm_entries = ns.vllm_entries + [{'inventory': host, 'address': scrape_host, 'port': hostvars[host].vllm_port | default(monitoring_vllm_port)}] %}
{% endif %}
{% endfor %}
{% if ns.vllm_entries | length > 0 %}
  - job_name: vllm
    metrics_path: /metrics
    static_configs:
{% for item in ns.vllm_entries %}
      - targets: ["{{ item.address }}:{{ item.port }}"]
        labels:
          host: "{{ item.inventory }}"
          service: vllm
{% endfor %}

  - job_name: vllm_health
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
{% for item in ns.vllm_entries %}
      - targets:
          - "http://{{ item.address }}:{{ item.port }}/health"
        labels:
          host: "{{ item.inventory }}"
          service: vllm
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ monitoring_blackbox_address }}"
{% endif %}
{% endif %}
