---
# Prometheus config generated from Ansible inventory (centralized scrape targets).

global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_prometheus_port }}"]

{% if monitoring_scrape_node_exporter | bool %}
  - job_name: node
    static_configs:
{% for host in groups['ai_nodes'] | default([]) %}
      - targets: ["{{ hostvars[host].monitoring_scrape_ip | default(hostvars[host].ansible_host) }}:{{ monitoring_node_exporter_port }}"]
        labels:
          host: "{{ host }}"
          role: inference
{% endfor %}
{% for host in groups['monitoring_nodes'] | default([]) %}
      - targets: ["{{ hostvars[host].monitoring_scrape_ip | default(hostvars[host].ansible_host) }}:{{ monitoring_node_exporter_port }}"]
        labels:
          host: "{{ host }}"
          role: utility
{% endfor %}
{% endif %}

{% if monitoring_scrape_dcgm | bool %}
  - job_name: dcgm
    static_configs:
{% for host in groups['ai_nodes'] | default([]) %}
      - targets: ["{{ hostvars[host].monitoring_scrape_ip | default(hostvars[host].ansible_host) }}:{{ monitoring_dcgm_port }}"]
        labels:
          host: "{{ host }}"
          role: gpu
{% endfor %}
{% endif %}

{% if monitoring_scrape_vllm | bool %}
  - job_name: vllm
    metrics_path: /metrics
    static_configs:
{% for host in groups['ai_nodes'] | default([]) %}
      - targets: ["{{ hostvars[host].monitoring_scrape_ip | default(hostvars[host].ansible_host) }}:{{ hostvars[host].vllm_port | default(monitoring_vllm_port) }}"]
        labels:
          host: "{{ host }}"
          service: vllm
{% endfor %}

  - job_name: vllm_health
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
{% for host in groups['ai_nodes'] | default([]) %}
      - targets:
          - "http://{{ hostvars[host].monitoring_scrape_ip | default(hostvars[host].ansible_host) }}:{{ hostvars[host].vllm_port | default(monitoring_vllm_port) }}/health"
        labels:
          host: "{{ host }}"
          service: vllm
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115
{% endif %}
