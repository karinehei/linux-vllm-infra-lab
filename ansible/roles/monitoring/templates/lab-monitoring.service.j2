[Unit]
Description=Lab monitoring stack (Prometheus/Grafana)
After=network-online.target
Wants=network-online.target
{% if container_runtime | default('podman') == 'docker' %}
After=docker.service
Requires=docker.service
{% endif %}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ monitoring_install_dir }}
EnvironmentFile=-{{ monitoring_install_dir }}/.env
{% if container_runtime | default('podman') == 'podman' %}
ExecStart=/usr/bin/podman compose -f {{ monitoring_install_dir }}/compose.yml up -d
ExecStop=/usr/bin/podman compose -f {{ monitoring_install_dir }}/compose.yml down
{% else %}
ExecStart=/usr/bin/docker compose -f {{ monitoring_install_dir }}/compose.yml up -d
ExecStop=/usr/bin/docker compose -f {{ monitoring_install_dir }}/compose.yml down
{% endif %}
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
