---
# ansible-lint for this lab — practical rules for Rocky/RHEL roles
profile: basic
offline: true
exclude_paths:
  - .github/
  - benchmarks/results/
  - .venv/
skip_list:
  - name[casing]
  - yaml[line-length]
  - experimental
  - no-handler
  - no-changed-when
  - command-instead-of-module
  - risky-shell-pipe
  - ignore-errors
  - literal-compare
  # Shared inventory vars by design: app_* (users + vllm), container_runtime (many roles).
  - var-naming[no-role-prefix]
warn_list:
  - role-name
mock_modules: []
mock_roles: []
