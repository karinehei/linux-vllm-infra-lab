# Example environment for compose / local experiments.
# Copy to vllm.env (gitignored) and edit. Do not put real tokens in git.
#
#   cp containers/vllm/vllm.env.example containers/vllm/vllm.env

# --- network (host publish address; container still listens on 0.0.0.0 internally) ---
VLLM_HOST=127.0.0.1
VLLM_PORT=8000

# --- model (OpenAI-compatible server; single-GPU friendly defaults) ---
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=4096
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_DTYPE=auto
VLLM_CONTAINER_IMAGE=vllm/vllm-openai:v0.6.3

# --- persistent paths on the host ---
VLLM_MODEL_PATH=/var/lib/vllm/models
VLLM_CACHE_PATH=/var/lib/vllm/cache

# --- Hugging Face (optional; leave empty for public models) ---
# Prefer Ansible Vault on managed hosts — see docs/security/secrets.md
HUGGING_FACE_HUB_TOKEN=
HF_TOKEN=
